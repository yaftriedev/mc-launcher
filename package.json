{
  "name": "mc-launcher",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "author": {
    "name": "yaftrie",
    "email": "yaftrie@gmail.com"
  },
  "homepage": "https://github.com/yaftriedev/mc-launcher",
  "license": "ISC",
  "scripts": {
    "start-react": "webpack serve --open",
    "start-electron": "wait-on http://localhost:8080 && electron .",
    "start": "concurrently \"npm run start-react\" \"npm run start-electron\"",
    "build-react": "webpack --mode production",
    "dist": "npm run build-react && electron-builder",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.yaftrie.mc-launcher",
    "productName": "Minecraft Launcher",

    "directories": {
      "output": "release"
    },

    "files": [
      "electron/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],

    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Game"
    },

    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^9.2.1",
    "concurrently": "^8.0.0",
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3",
    "html-webpack-plugin": "^5.6.6",
    "wait-on": "^7.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "@xmcl/core": "^2.15.1",
    "@xmcl/forge-site-parser": "^2.0.9",
    "@xmcl/installer": "^6.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
